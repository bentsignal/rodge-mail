{
  "name": "@rodge-mail/mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "portless \"$(../../scripts/portless-app-name.sh mobile.rodge-mail)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start",
    "dev:android": "portless \"$(../../scripts/portless-app-name.sh mobile.rodge-mail)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --android",
    "dev:ios": "portless \"$(../../scripts/portless-app-name.sh mobile.rodge-mail)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --ios",
    "android": "pnpm run dev:android",
    "ios": "pnpm run dev:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "install:ios-sim": "xcrun simctl install booted ./RodgeMail.app"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@better-auth/passkey": "1.6.11",
    "@convex-dev/better-auth": "catalog:",
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.9",
    "@expo/ui": "~57.0.10",
    "@legendapp/list": "catalog:",
    "@rodge-mail/config": "workspace:*",
    "@rodge-mail/convex": "workspace:*",
    "@rodge-mail/features": "workspace:*",
    "@rodge-mail/std": "workspace:*",
    "@rodge-mail/tailwind-config": "workspace:*",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "expo": "~57.0.12",
    "expo-better-auth-passkey": "1.4.3",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.562.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "~0.10.1",
    "rostra": "catalog:",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@rodge-mail/eslint-config": "workspace:*",
    "@rodge-mail/prettier-config": "workspace:*",
    "@rodge-mail/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "sharp": "0.34.4",
    "typescript": "catalog:",
    "vitest": "^4.0.17"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "prettier": "@rodge-mail/prettier-config"
}
